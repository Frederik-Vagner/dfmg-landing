<svg class="illustration" viewBox="0 0 480 320" role="img" aria-label="{{ illustrationAlt }}">
    <rect class="illustration__bg" x="0" y="0" width="480" height="320" rx="24"/>
    <rect class="illustration__card" x="170" y="16" width="140" height="288" rx="22"/>
    <rect class="illustration__text" x="218" y="30" width="44" height="8" rx="4"/>
    {% for row in [0, 1, 2] %}
    <rect class="illustration__card" x="186" y="{{ 60 + row * 76 }}" width="108" height="62" rx="10"/>
    <circle class="{{ ['illustration__primary', 'illustration__success', 'illustration__amber'][row] }}" cx="206" cy="{{ 91 + row * 76 }}" r="9"/>
    <rect class="illustration__text" x="224" y="{{ 80 + row * 76 }}" width="56" height="8" rx="4"/>
    <rect class="illustration__text" x="224" y="{{ 96 + row * 76 }}" width="36" height="8" rx="4"/>
    {% endfor %}
</svg>
