<svg class="illustration" viewBox="0 0 480 320" role="img" aria-label="{{ illustrationAlt }}">
    <rect class="illustration__bg" x="0" y="0" width="480" height="320" rx="24"/>
    {% for p in [[0, 1], [1, 2], [2, 0]] %}
    <rect class="illustration__card" x="56" y="{{ 36 + p[0] * 88 }}" width="368" height="72" rx="14"/>
    <circle class="illustration__primary-soft" cx="96" cy="{{ 72 + p[0] * 88 }}" r="20"/>
    <rect class="illustration__text" x="128" y="{{ 60 + p[0] * 88 }}" width="104" height="10" rx="5"/>
    <rect class="illustration__dull" x="128" y="{{ 78 + p[0] * 88 }}" width="72" height="8" rx="4"/>
    {% for step in [0, 1, 2] %}
    <rect class="{{ 'illustration__primary' if step <= p[1] else 'illustration__dull' }}" x="{{ 284 + step * 40 }}" y="{{ 62 + p[0] * 88 }}" width="32" height="20" rx="10"/>
    {% endfor %}
    {% endfor %}
</svg>
