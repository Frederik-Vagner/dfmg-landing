<svg class="illustration" viewBox="0 0 480 320" role="img" aria-label="{{ illustrationAlt }}">
    <rect class="illustration__bg" x="0" y="0" width="480" height="320" rx="24"/>
    <rect class="illustration__card" x="64" y="56" width="104" height="208" rx="52"/>
    <rect class="illustration__primary" x="96" y="88" width="40" height="88" rx="20"/>
    <path class="illustration__line" d="M88 168a28 28 0 0 0 56 0M116 196V228M100 228H132"/>
    <path class="illustration__route" d="M180 160H212"/>
    <rect class="illustration__card" x="224" y="40" width="208" height="240" rx="14"/>
    <rect class="illustration__text" x="248" y="64" width="120" height="12" rx="6"/>
    <rect class="illustration__dull" x="248" y="88" width="160" height="8" rx="4"/>
    <rect class="illustration__dull" x="248" y="104" width="140" height="8" rx="4"/>
    {% for row in [0, 1, 2] %}
    <rect class="illustration__success" x="248" y="{{ 140 + row * 40 }}" width="20" height="20" rx="5"/>
    <path class="illustration__mark" d="M252 {{ 150 + row * 40 }}L257 {{ 155 + row * 40 }}L264 {{ 146 + row * 40 }}"/>
    <rect class="illustration__text" x="280" y="{{ 145 + row * 40 }}" width="{{ [120, 96, 108][row] }}" height="10" rx="5"/>
    {% endfor %}
</svg>
