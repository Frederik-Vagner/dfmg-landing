<svg class="illustration" viewBox="0 0 480 320" role="img" aria-label="{{ illustrationAlt }}">
    <rect class="illustration__bg" x="0" y="0" width="480" height="320" rx="24"/>
    <rect class="illustration__card" x="72" y="32" width="208" height="256" rx="14"/>
    <rect class="illustration__text" x="96" y="56" width="120" height="14" rx="7"/>
    {% for w in [160, 144, 152, 128, 156, 120] %}
    <rect class="illustration__dull" x="96" y="{{ 88 + loop.index0 * 22 }}" width="{{ w }}" height="8" rx="4"/>
    {% endfor %}
    <circle class="illustration__card" cx="270" cy="150" r="48"/>
    <circle class="illustration__primary-soft" cx="270" cy="150" r="34"/>
    <rect class="illustration__primary" x="296" y="196" width="56" height="18" rx="9" transform="rotate(45 324 205)"/>
    <rect class="illustration__card" x="320" y="216" width="128" height="56" rx="12"/>
    <rect class="illustration__dull" x="336" y="238" width="96" height="12" rx="6"/>
    <rect class="illustration__success" x="336" y="238" width="72" height="12" rx="6"/>
</svg>
