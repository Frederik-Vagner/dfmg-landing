<svg class="illustration" viewBox="0 0 480 320" role="img" aria-label="{{ illustrationAlt }}">
    <rect class="illustration__bg" x="0" y="0" width="480" height="320" rx="24"/>
    <rect class="illustration__card" x="96" y="32" width="200" height="256" rx="14"/>
    <rect class="illustration__primary" x="120" y="56" width="72" height="14" rx="7"/>
    {% for w in [152, 136, 148, 120] %}
    <rect class="illustration__dull" x="120" y="{{ 92 + loop.index0 * 22 }}" width="{{ w }}" height="8" rx="4"/>
    {% endfor %}
    <rect class="illustration__primary-soft" x="120" y="196" width="152" height="40" rx="8"/>
    <rect class="illustration__text" x="120" y="252" width="80" height="10" rx="5"/>
    <circle class="illustration__success" cx="330" cy="120" r="54"/>
    <path class="illustration__mark" d="M298 120c10-14 20-20 32-20s22 6 32 20c-10 14-20 20-32 20s-22-6-32-20z"/>
    <circle class="illustration__card" cx="330" cy="120" r="8"/>
</svg>
