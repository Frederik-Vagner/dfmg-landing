    <!-- Hero -->
    <section class="hero hero--primary hero--compact">
        <div class="container">
            <div class="subtitle">{{ t.hero.subtitle }}</div>
            <h1 class="title">{{ t.hero.title }}</h1>
            <p class="body">{{ t.hero.body }}</p>
        </div>
    </section>

    <!-- Origin story -->
    <section class="section">
        <div class="container">
            <div class="row">
                <div class="intro intro--start">
                    <div class="subtitle intro__eyebrow intro__eyebrow--primary">{{ t.story.subtitle }}</div>
                    <h2 class="title title--compact">{{ t.story.title }}</h2>
                    <p class="body intro__text intro__text--tight">{{ t.story.body1 }}</p>
                    <p class="body intro__text intro__text--tight">{{ t.story.body2 }}</p>
                    <p class="body intro__text">{{ t.story.body3 }}</p>
                </div>
                <div>
                    <!-- TODO: Replace with team photo or photo of you working -->
                    <div class="screenshot-placeholder screenshot-placeholder--light" data-photo-slot="about-story" data-photo-status="missing" data-photo-brief="{{ t.story.placeholder_text | escape }}. {{ t.story.placeholder_hint | escape }}">
                        <div>
                            <iconify-icon icon="fluent:camera-20-filled" inline class="screenshot-placeholder__icon"></iconify-icon>
                            {{ t.story.placeholder_text }}<br>
                            {# note to self (not rendered): {{ t.story.placeholder_hint }} #}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Philosophy -->
    <section class="section section--light">
        <div class="container">
            <div class="intro intro--spaced">
                <div class="subtitle intro__eyebrow intro__eyebrow--primary">{{ t.philosophy.subtitle }}</div>
                <div class="title intro__title">{{ t.philosophy.title }}</div>
            </div>

            <div class="row">
                <div class="card card--soft card--accent-left card--accent-primary">
                    <h3 class="heading heading--sm">{{ t.philosophy.card1_title }}</h3>
                    <p>{{ t.philosophy.card1_desc }}</p>
                </div>
                <div class="card card--soft card--accent-left card--accent-primary">
                    <h3 class="heading heading--sm">{{ t.philosophy.card2_title }}</h3>
                    <p>{{ t.philosophy.card2_desc }}</p>
                </div>
                <div class="card card--soft card--accent-left card--accent-primary">
                    <h3 class="heading heading--sm">{{ t.philosophy.card3_title }}</h3>
                    <p>{{ t.philosophy.card3_desc }}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Tech approach -->
    <section class="section">
        <div class="container">
            <div class="row">
                <div>
                    <!-- TODO: Replace with simple architecture visual or tech stack diagram -->
                    <div class="screenshot-placeholder screenshot-placeholder--light" data-photo-slot="about-tech" data-photo-status="missing" data-photo-brief="{{ t.tech.placeholder_text | escape }}. {{ t.tech.placeholder_hint | escape }}">
                        <div>
                            <iconify-icon icon="fluent:organization-20-filled" inline class="screenshot-placeholder__icon"></iconify-icon>
                            {{ t.tech.placeholder_text }}<br>
                            {# note to self (not rendered): {{ t.tech.placeholder_hint }} #}
                        </div>
                    </div>
                </div>
                <div class="intro intro--start">
                    <div class="subtitle intro__eyebrow intro__eyebrow--primary">{{ t.tech.subtitle }}</div>
                    <h2 class="title title--compact">{{ t.tech.title }}</h2>
                    <ul class="checklist checklist--success">
                        <li><iconify-icon icon="fluent:checkmark-20-filled" inline></iconify-icon> <span><strong>{{ t.tech.item1_strong }}</strong> — {{ t.tech.item1_text }}</span></li>
                        <li><iconify-icon icon="fluent:checkmark-20-filled" inline></iconify-icon> <span><strong>{{ t.tech.item2_strong }}</strong> — {{ t.tech.item2_text }}</span></li>
                        <li><iconify-icon icon="fluent:checkmark-20-filled" inline></iconify-icon> <span><strong>{{ t.tech.item3_strong }}</strong> — {{ t.tech.item3_text }}</span></li>
                        <li><iconify-icon icon="fluent:checkmark-20-filled" inline></iconify-icon> <span><strong>{{ t.tech.item4_strong }}</strong> — {{ t.tech.item4_text }}</span></li>
                        <li><iconify-icon icon="fluent:checkmark-20-filled" inline></iconify-icon> <span><strong>{{ t.tech.item5_strong }}</strong> — {{ t.tech.item5_text }}</span></li>
                        <li><iconify-icon icon="fluent:checkmark-20-filled" inline></iconify-icon> <span><strong>{{ t.tech.item6_strong }}</strong> — {{ t.tech.item6_text }}</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Link to service company -->
    <section class="section">
        <div class="container">
            <div class="cta cta--center cta--primary">
                <div class="cta__title">{{ t.cta.title }}</div>
                <div class="cta__text">{{ t.cta.body }}</div>
                <div class="cluster cluster--center">
                    <a href="/pages/facility/indblik/om.html" class="btn btn--ghost btn--md">{{ t.cta.btn_team }}</a>
                    <a href="{{ prefix }}/demo.html" class="btn btn--success btn--md">{{ t.cta.btn_demo }}</a>
                </div>
            </div>
        </div>
    </section>
