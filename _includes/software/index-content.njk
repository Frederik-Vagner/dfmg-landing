    <!-- Hero — outcome-driven, not feature-driven -->
    <section class="platform-hero">
        <div class="container">
            <div class="subtitle" style="color: rgba(255,255,255,0.6);">{{ t.hero.subtitle }}</div>
            <h1 class="title">{{ t.hero.title }}</h1>
            <p class="body">{{ t.hero.body }}</p>
            <div class="hero-actions">
                <a href="{{ prefix }}/demo.html" class="btn btn--success btn--md"><iconify-icon icon="fluent:play-circle-20-filled" inline class="mr-05"></iconify-icon> {{ t.hero.cta_demo }}</a>
                <a href="{{ prefix }}/features.html" class="btn btn--ghost btn--md">{{ t.hero.cta_features }}</a>
            </div>

            <!-- TODO: Replace with actual dashboard screenshot or 60s product video -->
            <div class="screenshot-placeholder" style="min-height: 400px; margin-top: 3rem;">
                <div style="text-align: center;">
                    <iconify-icon icon="fluent:play-circle-20-filled" inline style="font-size: 3rem; margin-bottom: 1rem; display: block; opacity: 0.5;"></iconify-icon>
                    <span>{{ t.hero.placeholder_text }}</span><br>
                    {# note to self (not rendered): {{ t.hero.placeholder_hint }} #}
                </div>
            </div>
        </div>
    </section>

    {# Social proof + metrics section removed: the figures were "[X]h saved per week",
       "[X]% on-time" and a "[X] employees / [X] clients" line — placeholders, not measurements.
       Re-add the section once the numbers come from the platform's own data. #}

    <!-- Built by practitioners — your differentiator -->
    <section class="section section--light section--half">
        <div class="container">
            <div class="text-center">
                <div class="subtitle text-primary">{{ t.why.subtitle }}</div>
                <div class="title text-charcoal">{{ t.why.title }}</div>
                <div class="body text-gray mb-4">{{ t.why.body }}</div>
            </div>

            <div class="value-grid">
                <div class="card--feature card--feature--center">
                    <div class="card--feature__icon">
                        <iconify-icon icon="fluent:flag-20-filled" inline></iconify-icon>
                    </div>
                    <div class="card--feature__title">{{ t.why.card1_title }}</div>
                    <div class="card--feature__desc">{{ t.why.card1_desc }}</div>
                </div>
                <div class="card--feature card--feature--center">
                    <div class="card--feature__icon">
                        <iconify-icon icon="fluent:cube-multiple-20-filled" inline></iconify-icon>
                    </div>
                    <div class="card--feature__title">{{ t.why.card2_title }}</div>
                    <div class="card--feature__desc">{{ t.why.card2_desc }}</div>
                </div>
                <div class="card--feature card--feature--center">
                    <div class="card--feature__icon">
                        <iconify-icon icon="fluent:link-20-filled" inline></iconify-icon>
                    </div>
                    <div class="card--feature__title">{{ t.why.card3_title }}</div>
                    <div class="card--feature__desc">{{ t.why.card3_desc }}</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Module overview -->
    <section class="section">
        <div class="container">
            <div class="text-center mb-4">
                <div class="subtitle text-primary">{{ t.modules.subtitle }}</div>
                <div class="title text-charcoal">{{ t.modules.title }}</div>
                <div class="body text-gray">{{ t.modules.body }}</div>
            </div>

            <div class="module-grid">
                <a href="{{ prefix }}/features.html#operations" class="card--feature card--feature--filled card--feature--hover">
                    <div class="card--feature__icon"><iconify-icon icon="fluent:calendar-checkmark-20-filled" inline></iconify-icon></div>
                    <div class="card--feature__title">{{ t.modules.operations_title }}</div>
                    <div class="card--feature__desc">{{ t.modules.operations_desc }}</div>
                </a>
                <a href="{{ prefix }}/features.html#clients" class="card--feature card--feature--filled card--feature--hover">
                    <div class="card--feature__icon"><iconify-icon icon="fluent:people-20-filled" inline></iconify-icon></div>
                    <div class="card--feature__title">{{ t.modules.clients_title }}</div>
                    <div class="card--feature__desc">{{ t.modules.clients_desc }}</div>
                </a>
                <a href="{{ prefix }}/features.html#employees" class="card--feature card--feature--filled card--feature--hover">
                    <div class="card--feature__icon"><iconify-icon icon="fluent:person-20-filled" inline></iconify-icon></div>
                    <div class="card--feature__title">{{ t.modules.employees_title }}</div>
                    <div class="card--feature__desc">{{ t.modules.employees_desc }}</div>
                </a>
                <a href="{{ prefix }}/features.html#finance" class="card--feature card--feature--filled card--feature--hover">
                    <div class="card--feature__icon"><iconify-icon icon="fluent:calculator-20-filled" inline></iconify-icon></div>
                    <div class="card--feature__title">{{ t.modules.finance_title }}</div>
                    <div class="card--feature__desc">{{ t.modules.finance_desc }}</div>
                </a>
                <a href="{{ prefix }}/features.html#crm" class="card--feature card--feature--filled card--feature--hover">
                    <div class="card--feature__icon"><iconify-icon icon="fluent:mail-read-20-filled" inline></iconify-icon></div>
                    <div class="card--feature__title">{{ t.modules.crm_title }}</div>
                    <div class="card--feature__desc">{{ t.modules.crm_desc }}</div>
                </a>
                <a href="{{ prefix }}/features.html#documents" class="card--feature card--feature--filled card--feature--hover">
                    <div class="card--feature__icon"><iconify-icon icon="fluent:document-text-20-filled" inline></iconify-icon></div>
                    <div class="card--feature__title">{{ t.modules.documents_title }}</div>
                    <div class="card--feature__desc">{{ t.modules.documents_desc }}</div>
                </a>
            </div>
        </div>
