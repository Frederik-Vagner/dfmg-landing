    <!-- Hero — outcome-driven, not feature-driven -->
    <section class="hero hero--primary">
        <div class="container">
            <div class="subtitle">{{ t.hero.subtitle }}</div>
            <h1 class="title">{{ t.hero.title }}</h1>
            <p class="body">{{ t.hero.body }}</p>
            <div class="cluster cluster--center">
                <a href="{{ prefix }}/demo.html" class="btn btn--success btn--md"><iconify-icon icon="fluent:play-circle-20-filled" inline></iconify-icon> {{ t.hero.cta_demo }}</a>
                <a href="{{ prefix }}/features.html" class="btn btn--ghost btn--md">{{ t.hero.cta_features }}</a>
            </div>

            {% set heroShot = "/images/platform/schedule-month.webp" %}
            <img src="{{ heroShot }}" width="{{ heroShot | imgWidth }}" height="{{ heroShot | imgHeight }}" alt="{{ t.hero.image_alt }}" class="screenshot hero__media" fetchpriority="high" decoding="async" data-photo-slot="home-hero">
        </div>
    </section>

    {# Social proof + metrics section removed: the figures were "[X]h saved per week",
       "[X]% on-time" and a "[X] employees / [X] clients" line — placeholders, not measurements.
       Re-add the section once the numbers come from the platform's own data. #}

    <!-- Built by practitioners — your differentiator -->
    <section class="section section--light section--half">
        <div class="container">
            <div class="intro">
                <div class="subtitle intro__eyebrow intro__eyebrow--primary">{{ t.why.subtitle }}</div>
                <div class="title">{{ t.why.title }}</div>
                <div class="body intro__text intro__text--spaced">{{ t.why.body }}</div>
            </div>

            <div class="grid grid--3 grid--loose">
                <div class="card card--flat card--center">
                    <div class="icon-badge icon-badge--round">
                        <iconify-icon icon="fluent:flag-20-filled" inline></iconify-icon>
                    </div>
                    <div class="card__title">{{ t.why.card1_title }}</div>
                    <div class="card__text">{{ t.why.card1_desc }}</div>
                </div>
                <div class="card card--flat card--center">
                    <div class="icon-badge icon-badge--round">
                        <iconify-icon icon="fluent:cube-multiple-20-filled" inline></iconify-icon>
                    </div>
                    <div class="card__title">{{ t.why.card2_title }}</div>
                    <div class="card__text">{{ t.why.card2_desc }}</div>
                </div>
                <div class="card card--flat card--center">
                    <div class="icon-badge icon-badge--round">
                        <iconify-icon icon="fluent:link-20-filled" inline></iconify-icon>
                    </div>
                    <div class="card__title">{{ t.why.card3_title }}</div>
                    <div class="card__text">{{ t.why.card3_desc }}</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Module overview -->
    <section class="section">
        <div class="container">
            <div class="intro intro--spaced">
                <div class="subtitle intro__eyebrow intro__eyebrow--primary">{{ t.modules.subtitle }}</div>
                <div class="title intro__title">{{ t.modules.title }}</div>
                <div class="body intro__text">{{ t.modules.body }}</div>
            </div>

            <div class="grid grid--3">
                <a href="{{ prefix }}/features.html#operations" class="card card--lift">
                    <div class="icon-badge"><iconify-icon icon="fluent:calendar-checkmark-20-filled" inline></iconify-icon></div>
                    <div class="card__title">{{ t.modules.plan_title }}</div>
                    <div class="card__text">{{ t.modules.plan_desc }}</div>
                </a>
                <a href="{{ prefix }}/features.html#employees" class="card card--lift">
                    <div class="icon-badge"><iconify-icon icon="fluent:phone-20-filled" inline></iconify-icon></div>
                    <div class="card__title">{{ t.modules.visit_title }}</div>
                    <div class="card__text">{{ t.modules.visit_desc }}</div>
                </a>
                <a href="{{ prefix }}/features.html#quality" class="card card--lift">
                    <div class="icon-badge"><iconify-icon icon="fluent:camera-20-filled" inline></iconify-icon></div>
                    <div class="card__title">{{ t.modules.proof_title }}</div>
                    <div class="card__text">{{ t.modules.proof_desc }}</div>
                </a>
                <a href="{{ prefix }}/features.html#team" class="card card--lift">
                    <div class="icon-badge"><iconify-icon icon="fluent:people-team-20-filled" inline></iconify-icon></div>
                    <div class="card__title">{{ t.modules.team_title }}</div>
                    <div class="card__text">{{ t.modules.team_desc }}</div>
                </a>
                <a href="{{ prefix }}/features.html#inventory" class="card card--lift">
                    <div class="icon-badge"><iconify-icon icon="fluent:box-20-filled" inline></iconify-icon></div>
                    <div class="card__title">{{ t.modules.stock_title }}</div>
                    <div class="card__text">{{ t.modules.stock_desc }}</div>
                </a>
                <a href="{{ prefix }}/features.html#crm" class="card card--lift">
                    <div class="icon-badge"><iconify-icon icon="fluent:handshake-20-filled" inline></iconify-icon></div>
                    <div class="card__title">{{ t.modules.sell_title }}</div>
                    <div class="card__text">{{ t.modules.sell_desc }}</div>
                </a>
            </div>
        </div>
    </section>

    <!-- Product walkthrough — visual proof -->
    <section class="section section--primary">
        <div class="container">
            <div class="row row--center">
                <div>
                    <div class="title title--compact">{{ t.walkthrough.title }}</div>
                    <p>{{ t.walkthrough.body }}</p>
                    <a href="{{ prefix }}/demo.html" class="btn btn--success btn--md"><iconify-icon icon="fluent:play-circle-20-filled" inline></iconify-icon> {{ t.walkthrough.cta }}</a>
                </div>
                {% set walkShot = "/images/platform/app-home-phone.webp" %}
                <img src="{{ walkShot }}" width="{{ walkShot | imgWidth }}" height="{{ walkShot | imgHeight }}" alt="{{ t.walkthrough.image_alt }}" class="screenshot screenshot--phone" loading="lazy" decoding="async" data-photo-slot="home-walkthrough">
            </div>
        </div>
    </section>

    {# Testimonial section removed: it shipped "[Your testimonial here...]" plus three
       "[Future customer testimonial]" blocks attributed to "[Name], [Company]".
       Re-add with a real, attributed quote — your own counts as one. #}

    <!-- Comparison — what you're replacing -->
    <section class="section section--light">
        <div class="container">
            <div class="intro intro--spaced">
                <div class="title intro__title">{{ t.comparison.title }}</div>
                <div class="body intro__text">{{ t.comparison.body }}</div>
            </div>

            <div class="row row--loose">
                <div class="card">
                    <div class="card__title card__title--danger"><iconify-icon icon="fluent:dismiss-circle-20-filled" inline class="card__title-icon"></iconify-icon> {{ t.comparison.without_title }}</div>
                    <ul class="checklist checklist--red">
                        {% for item in t.comparison.without_items %}
                        <li><iconify-icon icon="fluent:dismiss-20-filled" inline></iconify-icon> {{ item }}</li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="card">
                    <div class="card__title card__title--success"><iconify-icon icon="fluent:checkmark-circle-20-filled" inline class="card__title-icon"></iconify-icon> {{ t.comparison.with_title }}</div>
                    <ul class="checklist checklist--success">
                        {% for item in t.comparison.with_items %}
                        <li><iconify-icon icon="fluent:checkmark-20-filled" inline></iconify-icon> {{ item }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    {# Integrations section removed (Nov 2026): none of the named integrations is
       proven in use yet, and two were finance (docs/platform-capabilities.md).
       Re-add one once it is LIVE there. #}

    <!-- Final CTA -->
    <section class="section">
        <div class="container">
            <div class="cta cta--center cta--primary">
                <div class="cta__title">{{ t.cta.title }}</div>
                <div class="cta__text">{{ t.cta.body }}</div>
                <div class="stack">
                    <div class="cluster cluster--center">
                        <a href="{{ prefix }}/demo.html" class="btn btn--success btn--md"><iconify-icon icon="fluent:calendar-checkmark-20-filled" inline></iconify-icon> {{ t.cta.cta_demo }}</a>
                        <a href="{{ prefix }}/pricing.html" class="btn btn--ghost btn--md">{{ t.cta.cta_pricing }}</a>
                    </div>
                    <div class="trust-row trust-row--on-dark">
                        <div class="trust-item"><iconify-icon icon="fluent:checkmark-circle-20-filled" inline></iconify-icon> {{ t.cta.trust1 }}</div>
                        <div class="trust-item"><iconify-icon icon="fluent:checkmark-circle-20-filled" inline></iconify-icon> {{ t.cta.trust2 }}</div>
                        <div class="trust-item"><iconify-icon icon="fluent:checkmark-circle-20-filled" inline></iconify-icon> {{ t.cta.trust3 }}</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
