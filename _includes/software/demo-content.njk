    <!-- Hero -->
    <section class="hero hero--primary hero--compact">
        <div class="container">
            <div class="subtitle">{{ t.hero.subtitle }}</div>
            <h1 class="title">{{ t.hero.title }}</h1>
            <p class="body">{{ t.hero.body }}</p>
        </div>
    </section>

    <!-- What happens next and how to reach us; the form beside it.
         This page is also the platform's contact page (contact.html redirects here). -->
    <section class="section section--light">
        <div class="container">
            <div class="row row--wide row--top">
                <div class="stack stack--loose">
                    <div class="intro intro--start">
                        <h2 class="title title--small">{{ t.next.title }}</h2>
                        <ul class="checklist checklist--success checklist--spaced">
                            {% for step in t.next.steps %}
                            <li><iconify-icon icon="fluent:checkmark-circle-20-filled" inline></iconify-icon> <span><strong>{{ loop.index }}. {{ step.title }}.</strong> {{ step.text }}</span></li>
                            {% endfor %}
                        </ul>
                    </div>
                    <div class="intro intro--start">
                        <h2 class="title title--small">{{ t.details.title }}</h2>
                        <div class="grid grid--2 grid--tight">
                            <div class="card">
                                <h3 class="heading heading--sm"><iconify-icon icon="fluent:mail-20-filled" inline></iconify-icon> {{ t.details.card_email }}</h3>
                                <p><a href="mailto:{{ site.platformEmail }}">{{ site.platformEmail }}</a></p>
                            </div>
                            <div class="card">
                                <h3 class="heading heading--sm"><iconify-icon icon="fluent:call-20-filled" inline></iconify-icon> {{ t.details.card_phone }}</h3>
                                <p><a href="tel:{{ site.phone }}">{{ site.phoneDisplay }}</a></p>
                            </div>
                            <div class="card">
                                <h3 class="heading heading--sm"><iconify-icon icon="fluent:clock-20-filled" inline></iconify-icon> {{ t.details.card_hours }}</h3>
                                <p>{{ t.details.card_hours_value }}</p>
                            </div>
                            <div class="card">
                                <h3 class="heading heading--sm"><iconify-icon icon="fluent:building-20-filled" inline></iconify-icon> {{ t.details.card_company }}</h3>
                                <p>{{ site.legalName }}<br>CVR: {{ site.cvr }}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card" id="request">
                    <h2 class="title title--small">{{ t.form.heading }}</h2>
                    <p class="body">{{ t.form.intro }}</p>
                    <form class="stacked-form" action="{{ site.formEndpoint if isProduction else '#preview' }}" method="POST">
                        <input type="hidden" name="_subject" value="{{ t.form.email_subject }}">
                        <input type="hidden" name="_next" value="https://dfmg.dk{{ t.formAction }}">
                        <div class="grid grid--2 grid--tight">
                            <div class="form-group">
                                <label for="demo-name">{{ t.form.label_name }}</label>
                                <input type="text" id="demo-name" name="name" autocomplete="name" placeholder="{{ t.form.placeholder_name }}" required>
                            </div>
                            <div class="form-group">
                                <label for="demo-company">{{ t.form.label_company }}</label>
                                <input type="text" id="demo-company" name="company" autocomplete="organization" placeholder="{{ t.form.placeholder_company }}">
                            </div>
                        </div>
                        <div class="grid grid--2 grid--tight">
                            <div class="form-group">
                                <label for="demo-email">{{ t.form.label_email }}</label>
                                <input type="email" id="demo-email" name="email" autocomplete="email" placeholder="{{ t.form.placeholder_email }}" required>
                            </div>
                            <div class="form-group">
                                <label for="demo-phone">{{ t.form.label_phone }}</label>
                                <input type="tel" id="demo-phone" name="phone" autocomplete="tel" placeholder="{{ t.form.placeholder_phone }}">
                            </div>
                        </div>
                        <div class="grid grid--2 grid--tight">
                            <div class="form-group">
                                <label for="demo-size">{{ t.form.label_size }}</label>
                                <select id="demo-size" name="size">
                                    <option value="">{{ t.form.option_default }}</option>
                                    {% for option in t.form.size_options %}
                                    <option value="{{ option }}">{{ option }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="demo-today">{{ t.form.label_today }}</label>
                                <select id="demo-today" name="planning_today">
                                    <option value="">{{ t.form.option_default }}</option>
                                    {% for option in t.form.today_options %}
                                    <option value="{{ option }}">{{ option }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="demo-message">{{ t.form.label_message }}</label>
                            <textarea id="demo-message" name="message" placeholder="{{ t.form.placeholder_message }}"></textarea>
                        </div>
                        <button type="submit" class="btn btn--success btn--md btn--full">
                            <iconify-icon icon="fluent:calendar-checkmark-20-filled" inline></iconify-icon> {{ t.form.submit }}
                        </button>
                        <p class="body">{{ t.form.privacy }}</p>
                    </form>
                </div>
            </div>
        </div>
    </section>
