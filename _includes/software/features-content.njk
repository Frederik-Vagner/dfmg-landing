    <!-- Hero -->
    <section class="hero hero--primary hero--compact">
        <div class="container">
            <div class="subtitle">{{ t.hero.subtitle }}</div>
            <h1 class="title">{{ t.hero.title }}</h1>
            <p class="body">{{ t.hero.body }}</p>
        </div>
    </section>

    <!-- Feature sections -->
    {% for section in t.sections %}
    <section class="{{ section.sectionClass }}" id="{{ section.id }}">
        <div class="container">
            <div class="row row--center row--wide{% if section.reverse %} row--reverse{% endif %}">
                <div class="feature">
                    <div class="feature__eyebrow">{{ section.subtitle }}</div>
                    <h2 class="feature__title">{{ section.title }}</h2>
                    <p class="feature__text">{{ section.body }}</p>
                    <div class="feature__tags">
                        {% for badge in section.badges %}
                        <span class="badge-inline badge-inline--sm badge-inline--light">{{ badge }}</span>
                        {% endfor %}
                    </div>
                </div>
                <div>
                    <div class="screenshot-placeholder screenshot-placeholder--light" data-photo-slot="features-{{ loop.index }}" data-photo-status="missing" data-photo-brief="{{ section.screenshotAlt | replace('Alt: ', '') | escape }}">
                        <div>
                            <iconify-icon icon="fluent:image-20-filled" inline class="screenshot-placeholder__icon"></iconify-icon>
                            {{ section.screenshot }}<br>
                            {# intern note til alt-tekst, ikke til visning: {{ section.screenshotAlt }} #}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    {% endfor %}

    <!-- Platform Admin callout -->
    <section class="section">
        <div class="container">
            <div class="callout callout--note">
                <div class="callout__title"><iconify-icon icon="fluent:shield-20-filled" inline></iconify-icon> {{ t.admin.title }}</div>
                <div class="callout__text">{{ t.admin.body }}</div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="section">
        <div class="container">
            <div class="cta cta--center cta--primary">
                <div class="cta__title">{{ t.cta.title }}</div>
                <div class="cta__text">{{ t.cta.body }}</div>
                <div class="cluster cluster--center">
                    <a href="{{ prefix }}/demo.html" class="btn btn--success btn--md">{{ t.cta.cta_demo }}</a>
                    <a href="{{ prefix }}/pricing.html" class="btn btn--ghost btn--md">{{ t.cta.cta_pricing }}</a>
                </div>
            </div>
        </div>
    </section>
