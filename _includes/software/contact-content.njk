    <!-- Hero -->
    <section class="hero hero--primary hero--compact">
        <div class="container">
            <div class="subtitle">{{ t.hero.subtitle }}</div>
            <h1 class="title">{{ t.hero.title }}</h1>
            <p class="body">{{ t.hero.body }}</p>
        </div>
    </section>

    <!-- Contact form + info -->
    <section class="section">
        <div class="container">
            <div class="row row--wide row--top">
                <div class="intro intro--start">
                    <h2 class="title title--small">{{ t.info.heading }}</h2>
                    <p class="body intro__text intro__text--tight">{{ t.info.body }}</p>

                    <div class="stack">
                        <ul class="checklist checklist--success">
                            <li><iconify-icon icon="fluent:checkmark-circle-20-filled" inline></iconify-icon>{{ t.info.bullet1 }}</li>
                            <li><iconify-icon icon="fluent:checkmark-circle-20-filled" inline></iconify-icon>{{ t.info.bullet2 }}</li>
                            <li><iconify-icon icon="fluent:checkmark-circle-20-filled" inline></iconify-icon>{{ t.info.bullet3 }}</li>
                            <li><iconify-icon icon="fluent:checkmark-circle-20-filled" inline></iconify-icon>{{ t.info.bullet4 }}</li>
                        </ul>

                        <div class="grid grid--2 grid--tight">
                            <div class="card">
                                <h3 class="heading heading--sm"><iconify-icon icon="fluent:mail-20-filled" inline></iconify-icon> {{ t.info.card_email }}</h3>
                                <p><a href="mailto:{{ site.platformEmail }}">{{ site.platformEmail }}</a></p>
                            </div>
                            <div class="card">
                                <h3 class="heading heading--sm"><iconify-icon icon="fluent:call-20-filled" inline></iconify-icon> {{ t.info.card_phone }}</h3>
                                <p><a href="tel:{{ site.phone }}">{{ site.phoneDisplay }}</a></p>
                            </div>
                            <div class="card">
                                <h3 class="heading heading--sm"><iconify-icon icon="fluent:clock-20-filled" inline></iconify-icon> {{ t.info.card_hours }}</h3>
                                <p>{{ t.info.card_hours_value }}</p>
                            </div>
                            <div class="card">
                                <h3 class="heading heading--sm"><iconify-icon icon="fluent:building-20-filled" inline></iconify-icon> {{ t.info.card_company }}</h3>
                                <p>{{ site.legalName }}<br>CVR: {{ site.cvr }}</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <h2 class="title title--small">{{ t.form.heading }}</h2>
                    <form class="stacked-form" action="https://formspree.io/f/xdkdrqkw" method="POST">
                        <input type="hidden" name="_subject" value="{{ t.form.email_subject }}">
                        <input type="hidden" name="_next" value="https://dfmg.dk{{ prefix }}/tak.html">
                        <div class="form-group">
                            <label for="contact-interest">{{ t.form.label_interest }}</label>
                            <select id="contact-interest" name="interest">
                                <option value="">{{ t.form.option_select }}</option>
                                <option value="demo">{{ t.form.option_demo }}</option>
                                <option value="pricing">{{ t.form.option_pricing }}</option>
                                <option value="partnership">{{ t.form.option_partnership }}</option>
                                <option value="other">{{ t.form.option_other }}</option>
                            </select>
                        </div>
                        <div class="grid grid--2 grid--tight">
                            <div class="form-group">
                                <label for="contact-company">{{ t.form.label_company }}</label>
                                <input type="text" id="contact-company" name="company" placeholder="{{ t.form.placeholder_company }}" required>
                            </div>
                            <div class="form-group">
                                <label for="contact-name">{{ t.form.label_name }}</label>
                                <input type="text" id="contact-name" name="name" placeholder="{{ t.form.placeholder_name }}" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="contact-email">{{ t.form.label_email }}</label>
                            <input type="email" id="contact-email" name="email" placeholder="{{ t.form.placeholder_email }}" required>
                        </div>
                        <div class="grid grid--2 grid--tight">
                            <div class="form-group form-group--code">
                                <label for="contact-code">{{ t.form.label_code }}</label>
                                <select id="contact-code" name="country_code">
                                    <option value="+45" selected>🇩🇰 +45</option>
                                    <option value="+46">🇸🇪 +46</option>
                                    <option value="+47">🇳🇴 +47</option>
                                    <option value="+49">🇩🇪 +49</option>
                                    <option value="+44">🇬🇧 +44</option>
                                    <option value="+31">🇳🇱 +31</option>
                                    <option value="+33">🇫🇷 +33</option>
                                    <option value="+34">🇪🇸 +34</option>
                                    <option value="+39">🇮🇹 +39</option>
                                    <option value="+41">🇨🇭 +41</option>
                                    <option value="+43">🇦🇹 +43</option>
                                    <option value="+48">🇵🇱 +48</option>
                                    <option value="+358">🇫🇮 +358</option>
                                    <option value="+353">🇮🇪 +353</option>
                                </select>
                            </div>
                            <div class="form-group form-group--phone">
                                <label for="contact-phone">{{ t.form.label_phone }}</label>
                                <input type="tel" id="contact-phone" name="phone" placeholder="{{ t.form.placeholder_phone }}" pattern="[0-9\s]{7,15}" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="contact-message">{{ t.form.label_message }}</label>
                            <textarea id="contact-message" name="message" placeholder="{{ t.form.placeholder_message }}"></textarea>
                        </div>
                        <button type="submit" class="btn btn--success btn--md btn--full">
                            <iconify-icon icon="fluent:send-20-filled" inline></iconify-icon> {{ t.form.btn_submit }}
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>
