    <!-- Hero -->
    <section class="hero hero--primary hero--compact">
        <div class="container">
            <div class="subtitle">{{ t.hero.subtitle }}</div>
            <h1 class="title">{{ t.hero.title }}</h1>
            <p class="body">{{ t.hero.body }}</p>
            <div class="cluster cluster--center">
                <a href="{{ prefix }}/demo.html" class="btn btn--success btn--md">{{ t.hero.cta_demo }}</a>
                <a href="#editor" class="btn btn--ghost btn--md">{{ t.hero.cta_how }}</a>
            </div>
        </div>
    </section>

    <!-- Trust badges -->
    <section class="section section--flush-bottom">
        <div class="container">
            <div class="trust-row">
                {% for item in t.trust %}
                <div class="trust-item"><iconify-icon icon="fluent:checkmark-circle-20-filled" inline></iconify-icon> {{ item }}</div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Editor -->
    <section class="section" id="editor">
        <div class="container">
            <div class="row row--center row--wide">
                <div>
                    <div class="feature__eyebrow">{{ t.editor.subtitle }}</div>
                    <h2 class="feature__title">{{ t.editor.title }}</h2>
                    <p class="feature__text">{{ t.editor.body1 }}</p>
                    <p class="feature__text">{{ t.editor.body2 }}</p>
                    <div class="feature__tags">
                        {% for badge in t.editor.badges %}
                        <span class="badge-inline badge-inline--sm badge-inline--light">{{ badge }}</span>
                        {% endfor %}
                    </div>
                </div>
                <div>
                    <div class="screenshot-placeholder screenshot-placeholder--light" data-photo-slot="floorplans-editor" data-photo-status="missing">
                        <div>
                            <iconify-icon icon="fluent:ruler-20-filled" inline class="placeholder-icon"></iconify-icon>
                            <strong class="feature-visual__title">{{ t.editor.visual_title }}</strong><br><br>
                            <div class="feature-visual__list">
                                {% for item in t.editor.visual_items %}
                                <iconify-icon icon="{{ item.icon }}" inline class="placeholder-list-icon"></iconify-icon> {{ item.text }}<br>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Real-world accuracy -->
    <section class="section section--light" id="accuracy">
        <div class="container">
            <div class="row row--center row--wide row--reverse">
                <div>
                    <div class="feature__eyebrow">{{ t.accuracy.subtitle }}</div>
                    <h2 class="feature__title">{{ t.accuracy.title }}</h2>
                    <p class="feature__text">{{ t.accuracy.body1 }}</p>
                    <p class="feature__text">{{ t.accuracy.body2 }}</p>
                    <div class="feature__tags">
                        {% for badge in t.accuracy.badges %}
                        <span class="badge-inline badge-inline--sm badge-inline--light">{{ badge }}</span>
                        {% endfor %}
                    </div>
                </div>
                <div>
                    <div class="screenshot-placeholder screenshot-placeholder--light" data-photo-slot="floorplans-accuracy" data-photo-status="missing">
                        <div>
                            <iconify-icon icon="fluent:map-20-filled" inline class="placeholder-icon"></iconify-icon>
                            <strong class="feature-visual__title">{{ t.accuracy.visual_title }}</strong><br><br>
                            <div class="feature-visual__list">
                                {% for step in t.accuracy.steps %}
                                <span class="feature-visual__step-number">{{ loop.index }}.</span> {{ step }}<br>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

