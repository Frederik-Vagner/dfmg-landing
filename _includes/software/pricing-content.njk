    <!-- Hero -->
    <section class="hero hero--primary hero--compact">
        <div class="container">
            <div class="subtitle">{{ t.hero.subtitle }}</div>
            <h1 class="title">{{ t.hero.title }}</h1>
            <p class="body">{{ t.hero.body }}</p>
        </div>
    </section>

    <!-- Tier cards -->
    <section class="section">
        <div class="container">
            <div class="grid grid--3 grid--loose plans">
                {% for tier in t.tiers %}
                <div class="plan{% if tier.featured %} plan--featured{% endif %}">
                    {% if tier.badge %}
                    <div class="badge-inline badge-inline--primary plan__badge">{{ tier.badge }}</div>
                    {% endif %}
                    <div class="plan__name">{{ tier.name }}</div>
                    <div class="plan__desc">{{ tier.desc }}</div>
                    <div class="plan__price">{{ tier.price }}</div>
                    <div class="plan__divider"></div>
                    <ul class="checklist checklist--success checklist--compact plan__features">
                        {% for feature in tier.features %}
                        <li><iconify-icon icon="fluent:checkmark-20-filled" inline></iconify-icon> {{ feature }}</li>
                        {% endfor %}
                    </ul>
                    <a href="{{ tier.ctaHref }}" class="{{ tier.ctaClass }}">{{ tier.ctaText }}</a>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Comparison table -->
    <section class="section section--light">
        <div class="container">
            <div class="intro intro--spaced">
                <div class="title intro__title">{{ t.comparison.title }}</div>
                <div class="body intro__text">{{ t.comparison.body }}</div>
            </div>

            <div class="table-scroll" tabindex="0" role="region" aria-label="{{ t.comparison.title }}">
            <table class="matrix">
                <thead>
                    <tr>
                        <th>{{ t.comparison.colModule }}</th>
                        <th>{{ t.comparison.colStarter }}</th>
                        <th>{{ t.comparison.colProfessional }}</th>
                        <th>{{ t.comparison.colEnterprise }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in t.comparison.categories %}
                    <tr class="matrix__category"><td colspan="4">{{ category.name }}</td></tr>
                    {% for row in category.rows %}
                    <tr>
                        <td>{{ row.module }}</td>
                        <td class="{% if row.starter %}matrix__check{% else %}matrix__dash{% endif %}">{% if row.starter %}<iconify-icon icon="fluent:checkmark-20-filled" inline></iconify-icon>{% else %}&#8212;{% endif %}</td>
                        <td class="{% if row.professional %}matrix__check{% else %}matrix__dash{% endif %}">{% if row.professional %}<iconify-icon icon="fluent:checkmark-20-filled" inline></iconify-icon>{% else %}&#8212;{% endif %}</td>
                        <td class="{% if row.enterprise %}matrix__check{% else %}matrix__dash{% endif %}">{% if row.enterprise %}<iconify-icon icon="fluent:checkmark-20-filled" inline></iconify-icon>{% else %}&#8212;{% endif %}</td>
                    </tr>
                    {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="section">
        <div class="container">
            <div class="intro intro--spaced">
                <div class="title intro__title">{{ t.faq.title }}</div>
            </div>

            <div class="faq-list">
                {% for item in t.faq.items %}
                <div class="faq-item">
                    <div class="faq-question" data-action="toggle-platform-faq">
                        <h2 class="heading heading--sm">{{ item.question }}</h2>
                        <iconify-icon icon="fluent:chevron-down-20-filled" inline></iconify-icon>
                    </div>
                    <div class="faq-answer">
                        <p>{{ item.answer }}</p>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Trust signals -->
    <section class="section section--flush-top">
        <div class="container">
            <div class="trust-row">
                {% for item in t.trust.items %}
                <div class="trust-item"><iconify-icon icon="fluent:checkmark-circle-20-filled" inline></iconify-icon> {{ item }}</div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Testimonial on pricing page -->
    {# Pricing testimonial removed: it shipped as "[Testimonial about value — e.g. ...]"
       attributed to "[Name], [Company], [X] employees". Re-add with a real, attributed quote. #}

    <!-- CTA -->
    <section class="section">
        <div class="container">
            <div class="cta cta--center cta--primary">
                <div class="cta__title">{{ t.cta.title }}</div>
                <div class="cta__text">{{ t.cta.body }}</div>
                <div class="cluster cluster--center">
                    <a href="{{ prefix }}/demo.html" class="btn btn--success btn--md"><iconify-icon icon="fluent:calendar-checkmark-20-filled" inline class="btn__icon"></iconify-icon> {{ t.cta.cta_demo }}</a>
                    <a href="{{ prefix }}/contact.html" class="btn btn--ghost btn--md">{{ t.cta.cta_sales }}</a>
                </div>
            </div>
        </div>
    </section>
